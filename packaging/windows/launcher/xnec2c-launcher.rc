#include <windows.h>

IDI_XNEC2C_ICON ICON "../../../files/xnec2c.ico"

1 RT_MANIFEST "xnec2c-launcher.manifest"

1 VERSIONINFO
 FILEVERSION 4,4,18,0
 PRODUCTVERSION 4,4,18,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Xnec2c contributors"
      VALUE "FileDescription", "Xnec2c console-free Windows launcher"
      VALUE "FileVersion", "4.4.18.0"
      VALUE "InternalName", "xnec2c-launcher"
      VALUE "LegalCopyright", "GPL-3.0-or-later; see COPYING"
      VALUE "OriginalFilename", "xnec2c-launcher.exe"
      VALUE "ProductName", "Xnec2c for Windows"
      VALUE "ProductVersion", "4.4.18.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
